# Supabase project values
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Production email confirmation callback. In Vercel, set this to:
# https://beyblade-x-sg.vercel.app/
VITE_AUTH_REDIRECT_URL=https://beyblade-x-sg.vercel.app/

# Set false only for local development if you intentionally want to bypass the auth gate.
VITE_REQUIRE_AUTH=true
